  "ideaContract": {
    "purpose": "Compose the NEO REZONANS trust-infrastructure repositories as one inspectable causal system without collapsing their distinct authority, evidence, memory, proof, persistence, and reinterpretation roles.",
    "expectedOutcome": "A consumer can identify exact canonical revisions for every layer and determine which facts may cross each boundary without inferring permissions or truth that the source layer did not grant.",
    "invariants": [
      "every default system dependency is pinned to a canonical main revision at observation time",
      "the host repository pins its pre-acceptance capability base so the snapshot cannot self-reference its own future merge commit",
      "evidence never becomes authority by omission or maturity",
      "causal analysis and verification do not themselves grant mutation authority",
      "historical provenance remains distinct from current semantic compatibility",
      "reinterpretation may supersede meaning without mutating source evidence",
      "every cross-repository edge declares allowed facts and forbidden inferences"
    ],
    "forbiddenOutcomes": [
      "branch-only capability treated as canonical system behavior",
      "evidence or review maturity treated as execution authority",
      "local verification treated as whole-system truth without boundary checks",
      "reinterpretation silently mutating historical evidence",
      "repository drift silently preserving an obsolete system snapshot",
      "self-referential snapshot commit identity"
    ]
  },
