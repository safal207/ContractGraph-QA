{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.qa/schema/adapter-manifest.schema.json",
  "title": "ContractGraph-QA Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "adapterId",
    "contract",
    "network",
    "scope",
    "search",
    "stateFields",
    "actions",
    "invariants"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "adapterId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "contract": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "network": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "authorization", "authorizationReference", "target"],
      "properties": {
        "scopeId": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "authorization": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "authorizationReference": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "target": { "type": "string", "minLength": 1, "pattern": "\\S" }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDepth"],
      "properties": {
        "maxDepth": { "type": "integer", "minimum": 1 }
      }
    },
    "stateFields": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display", "actor"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "display": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "actor": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "severity",
          "summary",
          "expression",
          "impact",
          "recommendation"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "title": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "severity": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "enum": ["critical", "high", "medium", "low", "info"]
          },
          "summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "expression": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "impact": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "recommendation": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      }
    }
  }
}
