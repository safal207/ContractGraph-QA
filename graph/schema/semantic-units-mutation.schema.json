{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.qa/schema/semantic-units-mutation-v0.1.json",
  "title": "Semantic Units Mutation v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generationId",
    "target",
    "sourcePath",
    "sourceSha256",
    "propertyInvariantId",
    "propertyDescription",
    "activationWitness",
    "requiredFaultClasses",
    "foundry",
    "unitBindings"
  ],
  "properties": {
    "schemaVersion": {"const": "semantic-units-mutation-v0.1"},
    "generationId": {"type": "string", "minLength": 1},
    "target": {"type": "string", "minLength": 3},
    "sourcePath": {"type": "string", "minLength": 1},
    "sourceSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "propertyInvariantId": {"type": "string", "minLength": 1},
    "propertyDescription": {"type": "string", "minLength": 1},
    "activationWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "evidenceSha256", "description"],
      "properties": {
        "observed": {"type": "boolean"},
        "evidenceSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "requiredFaultClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"const": "units_decimals"}
    },
    "foundry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "timeoutSeconds"],
      "properties": {
        "profile": {"type": "string", "minLength": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "unitBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "symbol",
          "unitId",
          "expectedDecimals",
          "alternateDecimals",
          "matchPath",
          "matchTest"
        ],
        "properties": {
          "symbol": {"type": "string", "minLength": 1},
          "unitId": {"type": "string", "minLength": 1},
          "expectedDecimals": {"type": "integer", "minimum": 0, "maximum": 77},
          "alternateDecimals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "integer", "minimum": 0, "maximum": 77}
          },
          "matchPath": {"type": "string", "minLength": 1},
          "matchTest": {"type": "string", "minLength": 1}
        }
      }
    },
    "scope": {"type": "string", "minLength": 1}
  }
}
