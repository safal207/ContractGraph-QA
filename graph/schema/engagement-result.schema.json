{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.qa/schema/engagement-result.schema.json",
  "title": "ContractGraph-QA Engagement Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "engagementId",
    "adapterId",
    "scopeId",
    "manifestSha256",
    "searchRunId",
    "replay",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "engagementId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "adapterId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "scopeId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "searchRunId": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "replay": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["invariantId", "status", "exploredCandidates", "notes"],
        "properties": {
          "invariantId": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "status": {
            "type": "string",
            "enum": ["violated", "not_found_within_bound", "inconclusive"]
          },
          "findingId": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "exploredCandidates": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string", "minLength": 1, "pattern": "\\S" },
          "path": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actionId", "preState", "postState", "effect"],
              "properties": {
                "actionId": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "parameter": {
                  "oneOf": [
                    { "type": "integer" },
                    { "type": "string" }
                  ]
                },
                "preState": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "postState": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "effect": { "type": "string", "minLength": 1, "pattern": "\\S" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "status": { "const": "violated" } }, "required": ["status"] },
            "then": { "required": ["findingId", "path"] },
            "else": {
              "not": {
                "anyOf": [
                  { "required": ["findingId"] },
                  { "required": ["path"] }
                ]
              }
            }
          }
        ]
      }
    }
  }
}
