{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.qa/schema/evm-receipt-profile-v0.1.json",
  "title": "ContractGraph-QA EVM Receipt Profile v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "traceIdPrefix",
    "chainId",
    "contractAddresses",
    "events"
  ],
  "properties": {
    "schemaVersion": {"const": "evm-receipt-profile-v0.1"},
    "profileId": {"type": "string", "minLength": 1},
    "traceIdPrefix": {"type": "string", "minLength": 1},
    "chainId": {
      "oneOf": [
        {"type": "integer", "minimum": 0},
        {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"}
      ]
    },
    "contractAddresses": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}
    },
    "scope": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/event"}
    }
  },
  "$defs": {
    "fieldSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source"],
      "properties": {
        "source": {
          "enum": ["constant", "eventRef", "txHash", "logIndex", "address", "topic", "dataWord"]
        },
        "value": {},
        "index": {"type": "integer", "minimum": 0},
        "decode": {"enum": ["uint256", "bytes32", "address", "bool"]},
        "enumMap": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "prefix": {"type": "string", "minLength": 1},
        "suffix": {"type": "string", "minLength": 1}
      }
    },
    "economicEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actionId", "effectKey", "occurrenceId", "applied"],
      "properties": {
        "actionId": {"$ref": "#/$defs/fieldSpec"},
        "effectKey": {"$ref": "#/$defs/fieldSpec"},
        "occurrenceId": {"$ref": "#/$defs/fieldSpec"},
        "applied": {"$ref": "#/$defs/fieldSpec"}
      }
    },
    "stateCommit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commitId",
        "conflictKey",
        "parentState",
        "parentVersion",
        "operation",
        "successorState",
        "successorVersion",
        "committed"
      ],
      "properties": {
        "commitId": {"$ref": "#/$defs/fieldSpec"},
        "conflictKey": {"$ref": "#/$defs/fieldSpec"},
        "parentState": {"$ref": "#/$defs/fieldSpec"},
        "parentVersion": {"$ref": "#/$defs/fieldSpec"},
        "operation": {"$ref": "#/$defs/fieldSpec"},
        "successorState": {"$ref": "#/$defs/fieldSpec"},
        "successorVersion": {"$ref": "#/$defs/fieldSpec"},
        "committed": {"$ref": "#/$defs/fieldSpec"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "topic0"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "topic0": {"type": "string", "pattern": "^0x[0-9a-fA-F]{64}$"},
        "economicEffect": {"$ref": "#/$defs/economicEffect"},
        "stateCommit": {"$ref": "#/$defs/stateCommit"}
      },
      "anyOf": [
        {"required": ["economicEffect"]},
        {"required": ["stateCommit"]}
      ]
    }
  }
}
