{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.qa/schema/economic-cardinality.schema.json",
  "title": "ContractGraph-QA Economic Effect Cardinality Model",
  "type": "object",
  "required": ["schemaVersion", "modelId", "invariantId", "events"],
  "properties": {
    "schemaVersion": { "type": "string", "minLength": 1 },
    "modelId": { "type": "string", "minLength": 1 },
    "invariantId": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eventId", "actionId", "effectKey", "occurrenceId", "applied"],
        "properties": {
          "eventId": { "type": "string", "minLength": 1 },
          "actionId": { "type": "string", "minLength": 1 },
          "effectKey": { "type": "string", "minLength": 1 },
          "occurrenceId": { "type": "string", "minLength": 1 },
          "applied": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
