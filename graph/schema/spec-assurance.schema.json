{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph-qa.local/schema/spec-assurance-v0.1.json",
  "title": "ContractGraph-QA Specification Assurance Model v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "assuranceId",
    "assuranceInvariantId",
    "propertyInvariantId",
    "propertyDescription",
    "baseline",
    "activationWitness",
    "requiredFaultClasses",
    "mutations"
  ],
  "properties": {
    "schemaVersion": {"const": "spec-assurance-v0.1"},
    "assuranceId": {"type": "string", "minLength": 1},
    "assuranceInvariantId": {"const": "CGQ-SPEC-001"},
    "propertyInvariantId": {"type": "string", "minLength": 1},
    "propertyDescription": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentId", "evidenceSha256", "status"],
      "properties": {
        "assessmentId": {"type": "string", "minLength": 1},
        "evidenceSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "status": {"enum": ["pass", "fail", "inconclusive"]}
      }
    },
    "activationWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "evidenceSha256", "description"],
      "properties": {
        "observed": {"type": "boolean"},
        "evidenceSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "requiredFaultClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mutationId", "description", "faultClass", "evidenceSha256", "result"],
        "properties": {
          "mutationId": {"type": "string", "minLength": 1},
          "description": {"type": "string", "minLength": 1},
          "faultClass": {"type": "string", "minLength": 1},
          "evidenceSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "result": {"enum": ["detected", "survived", "inconclusive"]}
        }
      }
    }
  }
}
