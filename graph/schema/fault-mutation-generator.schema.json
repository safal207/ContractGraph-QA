{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph-qa.local/schema/fault-mutation-generator.schema.json",
  "title": "ContractGraph-QA Fault Mutation Generator v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generationId",
    "sourcePath",
    "sourceSha256",
    "propertyInvariantId",
    "propertyDescription",
    "activationWitness",
    "requiredFaultClasses",
    "foundry",
    "testBindings",
    "maxMutationsPerFaultClass"
  ],
  "properties": {
    "schemaVersion": {"const": "fault-mutation-generator-v0.1"},
    "generationId": {"type": "string", "minLength": 1},
    "sourcePath": {"type": "string", "minLength": 1},
    "sourceSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "propertyInvariantId": {"type": "string", "minLength": 1},
    "propertyDescription": {"type": "string", "minLength": 1},
    "activationWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed", "evidenceSha256", "description"],
      "properties": {
        "observed": {"type": "boolean"},
        "evidenceSha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "requiredFaultClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "foundry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "timeoutSeconds"],
      "properties": {
        "profile": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600}
      }
    },
    "testBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["faultClass", "function", "matchPath", "matchTest"],
        "properties": {
          "faultClass": {"type": "string", "minLength": 1},
          "function": {"type": "string", "minLength": 1},
          "matchPath": {"type": "string", "minLength": 1},
          "matchTest": {"type": "string", "minLength": 1}
        }
      }
    },
    "maxMutationsPerFaultClass": {"type": "integer", "minimum": 1, "maximum": 50},
    "scope": {"type": "string", "minLength": 1}
  }
}
