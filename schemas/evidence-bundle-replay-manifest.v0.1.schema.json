{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/safal207/ContractGraph-QA/schemas/evidence-bundle-replay-manifest.v0.1.schema.json",
  "title": "Provider-neutral evidence-bundle and replay manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "bundle_root",
    "scope",
    "subjects",
    "artifacts",
    "replay",
    "authority",
    "collection"
  ],
  "properties": {
    "schema": {
      "const": "cgqa.p1-2-evidence-bundle-replay-manifest.v0.1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "bundle_root": {
      "const": "bundle"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "mode", "claim_limit"],
      "properties": {
        "operation_id": {"type": "string"},
        "mode": {"const": "bounded_fixture"},
        "claim_limit": {"type": "string", "minLength": 1}
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/subject"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trace_id",
        "mode",
        "replayable",
        "expected_result",
        "side_effects_executed",
        "required_artifact_ids",
        "steps"
      ],
      "properties": {
        "trace_id": {"type": "string"},
        "mode": {"const": "deterministic_read_only"},
        "replayable": {"const": true},
        "expected_result": {"const": "SAME_RESULT"},
        "side_effects_executed": {"const": false},
        "required_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/replayStep"}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "proposal_is_not_authorization",
        "execution_authorized",
        "external_effects_authorized",
        "mutation_authorized"
      ],
      "properties": {
        "mode": {"const": "advisory_only"},
        "proposal_is_not_authorization": {"const": true},
        "execution_authorized": {"const": false},
        "external_effects_authorized": {"const": false},
        "mutation_authorized": {"const": false}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "started_at",
        "completed_at",
        "collected_at",
        "method",
        "environment"
      ],
      "properties": {
        "attempt_id": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"},
        "collected_at": {"type": "string", "format": "date-time"},
        "method": {"type": "string"},
        "environment": {"type": "string"}
      }
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "branch", "role", "head_sha", "observed_at"],
      "properties": {
        "id": {"type": "string"},
        "repository": {"type": "string"},
        "branch": {"type": "string"},
        "role": {"type": "string"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "observed_at": {"type": "string", "format": "date-time"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "role",
        "component",
        "source_revision",
        "bytes",
        "sha256",
        "content_type",
        "origin",
        "trust_domain",
        "valid_time",
        "transaction_time",
        "collected_at"
      ],
      "properties": {
        "artifact_id": {"type": "string"},
        "path": {"type": "string"},
        "role": {"type": "string"},
        "component": {"type": "string"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_type": {"type": "string"},
        "origin": {"type": "string"},
        "trust_domain": {"type": "string"},
        "valid_time": {"type": "string", "format": "date-time"},
        "transaction_time": {"type": "string", "format": "date-time"},
        "collected_at": {"type": "string", "format": "date-time"}
      }
    },
    "replayStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "action",
        "input_artifact_ids",
        "output_artifact_ids",
        "side_effect_executed"
      ],
      "properties": {
        "sequence": {"type": "integer", "minimum": 1},
        "action": {"type": "string"},
        "input_artifact_ids": {"type": "array", "items": {"type": "string"}},
        "output_artifact_ids": {"type": "array", "items": {"type": "string"}},
        "side_effect_executed": {"const": false}
      }
    }
  }
}
