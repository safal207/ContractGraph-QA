{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph-qa.example/schemas/adapter-manifest.schema.json",
  "title": "Temporal Transition Field Adapter Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "adapter_id",
    "target_kind",
    "scope",
    "execution",
    "credentials",
    "capabilities",
    "state_contract",
    "evidence_contract"
  ],
  "properties": {
    "schema_version": {"const": "0.6"},
    "adapter_id": {"type": "string", "minLength": 1},
    "target_kind": {
      "enum": ["synthetic", "rest_api", "smart_contract", "agent_wallet", "workflow"]
    },
    "scope": {
      "type": "object",
      "required": ["environment", "authorized", "production", "target"],
      "properties": {
        "environment": {"enum": ["local", "sandbox", "test", "local-fork"]},
        "authorized": {"const": true},
        "production": {"const": false},
        "target": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["dry_run_default", "max_concurrency", "max_depth", "max_paths"],
      "properties": {
        "dry_run_default": {"type": "boolean"},
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 8},
        "max_depth": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_paths": {"type": "integer", "minimum": 1, "maximum": 10000}
      },
      "additionalProperties": false
    },
    "credentials": {
      "type": "object",
      "required": ["source", "required_env_vars"],
      "properties": {
        "source": {"enum": ["none", "environment"]},
        "required_env_vars": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["snapshot", "apply", "coverage_mode", "supported_events"],
      "properties": {
        "snapshot": {"const": true},
        "apply": {"const": true},
        "coverage_mode": {"enum": ["full_model"]},
        "supported_events": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "state_contract": {
      "type": "object",
      "required": ["required_values"],
      "properties": {
        "required_values": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "evidence_contract": {
      "type": "object",
      "required": ["required_fields"],
      "properties": {
        "required_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
