{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph-qa.local/schemas/gonka-atman-runtime-fingerprint-v0.2.json",
  "title": "Gonka ATMAN runtime fingerprint v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","case_id","source_revision","runtime_artifacts","config_generation","captured_at","provenance","verdict"],
  "properties": {
    "schema_version": {"const": "gonka-atman-runtime-fingerprint-v0.2"},
    "case_id": {"const": "G-005"},
    "source_revision": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "runtime_artifacts": {
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["component","container_id","image_id","image_ref","image_digest"],"properties":{
        "component":{"enum":["devshardctl","versiond","devshardd","versiond-router"]},
        "container_id":{"type":"string","minLength":1},
        "image_id":{"type":"string","minLength":1},
        "image_ref":{"type":"string","minLength":1},
        "image_digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
      }}
    },
    "provenance": {
      "type":"object","additionalProperties":false,
      "required":["method","source_revision","evidence_sha256","component_image_digests"],
      "properties":{
        "method":{"enum":["local-build-from-pinned-source","oci-attestation"]},
        "source_revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "evidence_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
        "component_image_digests":{"type":"object","minProperties":3,"additionalProperties":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
      }
    },
    "config_generation":{"type":"string","minLength":1},
    "captured_at":{"type":"string","format":"date-time"},
    "verdict":{"enum":["PROVEN","UNPROVEN","MISMATCH"]},
    "notes":{"type":"string"}
  }
}
