{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph-qa.local/schemas/gonka-atman-runtime-fingerprint-v0.1.json",
  "title": "Gonka ATMAN runtime fingerprint v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","case_id","source_revision","runtime_artifacts","config_generation","captured_at","verdict"],
  "properties": {
    "schema_version": {"const": "gonka-atman-runtime-fingerprint-v0.1"},
    "case_id": {"const": "G-005"},
    "source_revision": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "runtime_artifacts": {
      "type":"array","minItems":1,
      "items":{"type":"object","additionalProperties":false,"required":["component","artifact_ref","sha256"],"properties":{
        "component":{"enum":["devshardctl","versiond","devshardd","versiond-router"]},
        "artifact_ref":{"type":"string","minLength":1},
        "sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
      }}
    },
    "config_generation":{"type":"string","minLength":1},
    "captured_at":{"type":"string","format":"date-time"},
    "verdict":{"enum":["PROVEN","UNPROVEN","MISMATCH"]},
    "notes":{"type":"string"}
  }
}
