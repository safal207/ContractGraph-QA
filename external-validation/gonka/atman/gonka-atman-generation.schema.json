{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph-qa.local/schemas/gonka-atman-generation-v0.1.json",
  "title": "Gonka ATMAN Generation Consistency v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_revision",
    "runtime_generation",
    "evidence_generation",
    "verdict"
  ],
  "properties": {
    "schema_version": {"const": "gonka-atman-generation-v0.1"},
    "source_revision": {"type": "string", "minLength": 1},
    "runtime_generation": {"type": "string", "minLength": 1},
    "runtime_fingerprint": {"type": "string", "minLength": 1},
    "evidence_generation": {"type": "string", "minLength": 1},
    "protocol_generation": {"type": ["string", "null"]},
    "captured_at": {"type": "string", "format": "date-time"},
    "freshness_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "verdict": {
      "enum": [
        "PASS",
        "VERIFIER_GENERATION_MISMATCH",
        "STALE_EVIDENCE",
        "INCONCLUSIVE"
      ]
    },
    "notes": {"type": "string"}
  }
}
