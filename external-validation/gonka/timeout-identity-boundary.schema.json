{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph-qa.local/schemas/gonka-timeout-identity-boundary-v0.1.json",
  "title": "Gonka G-002-ID timeout identity boundary evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "run_id",
    "upstream_revision",
    "environment",
    "client_request_id",
    "response_request_id",
    "transport_outcome",
    "client_timeout_observed",
    "escrow_id",
    "accounting_resolved_by_client_id",
    "state_nonce_before",
    "state_nonce_after",
    "state_progressed",
    "execution_observed_after_timeout",
    "verdict",
    "private_hypothesis_id",
    "notes"
  ],
  "properties": {
    "schema_version": { "const": "gonka-timeout-identity-boundary-v0.1" },
    "case_id": { "const": "G-002-ID" },
    "run_id": { "type": "string", "minLength": 1 },
    "upstream_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "environment": { "const": "gonka-local-devshard-testenv" },
    "client_request_id": { "type": "string", "minLength": 1 },
    "response_request_id": { "type": "string" },
    "transport_outcome": {
      "type": "string",
      "enum": ["client_timeout_ambiguous", "transport_error", "unexpected_response"]
    },
    "client_timeout_observed": { "type": "boolean" },
    "escrow_id": { "type": "string", "minLength": 1 },
    "accounting_resolved_by_client_id": { "type": "boolean" },
    "state_nonce_before": { "type": ["integer", "null"], "minimum": 0 },
    "state_nonce_after": { "type": ["integer", "null"], "minimum": 0 },
    "state_progressed": { "type": "boolean" },
    "execution_observed_after_timeout": { "type": "boolean" },
    "verdict": { "type": "string", "enum": ["PASS", "FAIL", "INCONCLUSIVE"] },
    "private_hypothesis_id": { "type": ["string", "null"] },
    "notes": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "verdict": { "const": "FAIL" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "client_timeout_observed": { "const": true },
          "execution_observed_after_timeout": { "const": true },
          "accounting_resolved_by_client_id": { "const": false },
          "private_hypothesis_id": { "const": "CGQA-GONKA-002" }
        }
      }
    },
    {
      "if": { "properties": { "verdict": { "const": "PASS" } }, "required": ["verdict"] },
      "then": {
        "properties": {
          "client_timeout_observed": { "const": true },
          "execution_observed_after_timeout": { "const": true },
          "accounting_resolved_by_client_id": { "const": true },
          "private_hypothesis_id": { "type": "null" }
        }
      }
    }
  ]
}
