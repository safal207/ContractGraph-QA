{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.qa/schemas/payment-fulfillment-scenario-v0.1.schema.json",
  "title": "ContractGraph-QA Payment Fulfillment Coupling Scenario v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenarioId",
    "logicalOperationId",
    "payment",
    "fulfillment",
    "nextAction"
  ],
  "properties": {
    "schema": {"const": "cgqa.payment-fulfillment-scenario.v0.1"},
    "scenarioId": {"type": "string", "minLength": 1},
    "logicalOperationId": {"type": "string", "minLength": 1},
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "evidence"],
      "properties": {
        "outcome": {"enum": ["committed", "failed", "pending", "unknown"]},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "fulfillment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "evidence"],
      "properties": {
        "outcome": {"enum": ["delivered", "not_delivered", "unknown"]},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "nextAction": {
      "enum": [
        "new_payment",
        "retry_payment",
        "repurchase",
        "hold",
        "stop",
        "reconcile",
        "compensate"
      ]
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
