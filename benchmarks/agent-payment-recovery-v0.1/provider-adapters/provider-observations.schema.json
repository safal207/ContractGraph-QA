{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.qa/schemas/payment-provider-observations.v0.1.schema.json",
  "title": "ContractGraph-QA Payment Provider Observations v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "logicalOperationId", "executionId", "observations"],
  "properties": {
    "schema": {"const": "cgqa.payment-provider-observations.v0.1"},
    "logicalOperationId": {"type": "string", "minLength": 1},
    "executionId": {"type": "string", "minLength": 1},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "providerState", "evidenceRef"],
        "properties": {
          "source": {"type": "string", "minLength": 1},
          "providerState": {"type": "string", "minLength": 1},
          "evidenceRef": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
