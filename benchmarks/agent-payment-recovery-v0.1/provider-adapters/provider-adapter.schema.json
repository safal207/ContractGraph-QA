{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractgraph.qa/schemas/payment-provider-adapter.v0.1.schema.json",
  "title": "ContractGraph-QA Payment Provider Adapter v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "providerId",
    "profileVersion",
    "create",
    "stateMap",
    "evidenceSources",
    "evidencePrecedence",
    "retryPolicy",
    "publicContractRefs"
  ],
  "properties": {
    "schema": {"const": "cgqa.payment-provider-adapter.v0.1"},
    "providerId": {"type": "string", "minLength": 1},
    "profileVersion": {"type": "string", "minLength": 1},
    "create": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supportsIdempotencyKey", "sameKeyReplayDocumented"],
      "properties": {
        "supportsIdempotencyKey": {"type": "boolean"},
        "sameKeyReplayDocumented": {"type": "boolean"}
      }
    },
    "stateMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": ["committed", "failed", "pending", "unknown"]
      }
    },
    "evidenceSources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "authoritativeForFinality"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "authoritativeForFinality": {"type": "boolean"}
        }
      }
    },
    "evidencePrecedence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "retryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forbidBeforeFinalReconciliation",
        "forbidAfterCommitted",
        "requireSameLogicalOperationId",
        "requireSameIdempotencyKey"
      ],
      "properties": {
        "forbidBeforeFinalReconciliation": {"type": "boolean"},
        "forbidAfterCommitted": {"type": "boolean"},
        "requireSameLogicalOperationId": {"type": "boolean"},
        "requireSameIdempotencyKey": {"type": "boolean"}
      }
    },
    "publicContractRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    }
  }
}
